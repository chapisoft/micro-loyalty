# ==============================================================================
# HỆ THỐNG LOYALTY ON-PREMISE DÀNH CHO VÍ NATCASH (NATCASH ON-PREMISE) - MẪU
# Vị trí: deploy/natcash/.env.example
# ==============================================================================

DEPLOY_MODEL=NATCASH_ONPREMISE
ENVIRONMENT=onpremise-production
SPRING_PROFILES_ACTIVE=prod,onprem,natcash

PARTNER_CODE=NATCASH_WALLET
TENANT_DEFAULT=TENANT_NATCASH

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=natcash_loyalty_db
POSTGRES_USER=natcash_loyalty
POSTGRES_PASSWORD=your_secure_postgres_pass
POSTGRES_MAX_POOL_SIZE=30
POSTGRES_MIN_IDLE=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_pass
REDIS_DATABASE=0

LOYALTY_SERVICE_PORT=8085
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/app/config/

ONPREM_HTTP_PORT=80
ONPREM_HTTPS_PORT=443
INTERNAL_DOMAIN=loyalty-internal.natcash.ht
API_GATEWAY_URL=http://loyalty-internal.natcash.ht/loyalty
NATCASH_API_GW_ENDPOINT=http://natcash-eu-api:8080
