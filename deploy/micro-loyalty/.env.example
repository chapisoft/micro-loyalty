# ==============================================================================
# HỆ SINH THÁI LOYALTY — MÔ HÌNH SAAS MULTI-TENANT (MICRO-LOYALTY) - MẪU MÔI TRƯỜNG
# Vị trí: deploy/micro-loyalty/.env.example
# ==============================================================================

DEPLOY_MODEL=MICRO_LOYALTY_SAAS
ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=prod,saas

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=loyalty_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_MAX_POOL_SIZE=50
POSTGRES_MIN_IDLE=10

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_DATABASE=0

LOYALTY_SERVICE_PORT=8085
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/app/config/

CMS_PORT=8080
WEBVIEW_PORT=8081
GATEWAY_HTTP_PORT=18090

PUBLIC_DOMAIN=loyalty.natcash.com
API_GATEWAY_URL=https://loyalty-api.natcash.com
PUBLIC_CMS_URL=https://cms-loyalty.natcash.com
PUBLIC_WEBVIEW_URL=https://gamehub.natcash.com

JASYPT_ENCRYPTOR_PASSWORD=your_jasypt_secret_key
OUTBOX_MAX_RETRIES=5
DRIFT_TOLERANCE_SECONDS=300
