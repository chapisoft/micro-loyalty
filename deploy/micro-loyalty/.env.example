# ==============================================================================
# HỆ SINH THÁI LOYALTY — MÔ HÌNH SAAS ĐA THUÊ BAO (MICRO-LOYALTY)
# Máy chủ: 210.211.102.99:65000 (User: dip) — Đồng máy chủ với DIP & Smart-OTP
# Vị trí: deploy/micro-loyalty/.env.example
# ==============================================================================

DEPLOY_MODEL=MICRO_LOYALTY_SAAS
ENVIRONMENT=uat
SPRING_PROFILES_ACTIVE=prod,saas

# 1. Cơ sở dữ liệu PostgreSQL 15+ Độc Lập Chuyên Dụng (loyalty_db)
POSTGRES_HOST=postgres
POSTGRES_PORT=15435
POSTGRES_DB=loyalty_db
POSTGRES_USER=loyalty_app
POSTGRES_PASSWORD=Loyalty_SecureDB2026!
POSTGRES_MAX_POOL_SIZE=30
POSTGRES_MIN_IDLE=5

# 2. Redis 7 Chuyên Dụng (Khóa Redisson RLock & DECRBY)
REDIS_HOST=redis
REDIS_PORT=16385
REDIS_PASSWORD=Loyalty_RedisPass2026!
REDIS_DATABASE=0
REDIS_POOL_MAX_TOTAL=50
REDIS_POOL_MAX_IDLE=10

# 3. Loyalty Service Backend (Cấu hình ngoại vi & Vòng đời nhật ký UAT 3 ngày)
LOYALTY_SERVICE_PORT=8088
LOYALTY_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/app/config/
LOG_MAX_HISTORY_DAYS=3
LOG_MAX_FILE_SIZE=20MB

# 4. Cổng Mạng Ánh Xạ Host Gateway (Chống xung đột với DIP & Smart-OTP)
GATEWAY_HTTP_PORT=18095

# 5. Tên Miền Công Khai & Điểm Cuối Dịch Vụ SaaS
PUBLIC_DOMAIN=loyalty.dip.io.vn
API_GATEWAY_URL=https://api.loyalty.dip.io.vn
PUBLIC_CMS_URL=https://cms.loyalty.dip.io.vn
PUBLIC_WEBVIEW_URL=https://game.loyalty.dip.io.vn

# 6. Bảo Mật & Giám Sát
JASYPT_ENCRYPTOR_PASSWORD=LoyaltySaasProductionSecretKey2026!
OUTBOX_MAX_RETRIES=5
DRIFT_TOLERANCE_SECONDS=300
