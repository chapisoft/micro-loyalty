**/target/
!**/src/main/**/target/
!**/src/test/**/target/

*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
*.lst
classes.lst

# Maven Wrapper Configuration
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
.mvn/timing.properties
.mvn/wrapper/.maven/
HELP.md

